#!/bin/bash
# cc-run ID TIMEOUT — task on stdin; settings in env (set by tools/claude_box_relay.py):
#   CC_MODEL (haiku|sonnet|opus, default haiku), CC_BUDGET (USD per job, default 1),
#   CC_RESUME (session id), CC_MODE (permission mode, default auto), CC_CACHE_TTL (prompt
#   cache, default 1h: spoken follow-ups come minutes apart, past the 5-minute default).
# Runs Claude Code headless, waits, prints the result JSON. tmux window cc-ID shows it live.
#
# Installed root-owned at /usr/local/bin/cc-run, with Claude Code at /usr/local/bin/claude and
# the instructions at /etc/clara-box/CLAUDE.md, so a job cannot change what later jobs run:
#   --bare                 no hooks, plugins, auto-memory or CLAUDE.md files from clara's space
#   --setting-sources ""   no settings files from clara's space (an "env" there could redirect
#                          the API); the instructions come only from the root-owned file
#   setpriv --no-new-privs no setuid programs (sudo, su) gain privileges inside a job
#   full paths             nothing on clara's PATH or in her tmux sits between this and Claude
# The job still runs as clara and can change her files (~/work, sessions, the key file).
set -u
P=/usr/bin
id=${1:-}; secs=${2:-600}
model=${CC_MODEL:-haiku}; budget=${CC_BUDGET:-1}; resume=${CC_RESUME:-}; mode=${CC_MODE:-auto}
fail() { printf '{"is_error":true,"result":"%s"}\n' "$1"; exit 2; }
[[ $id =~ ^[A-Za-z0-9_-]{1,32}$ ]] || fail "cc-run: bad task id"
[[ $secs =~ ^[0-9]{1,5}$ ]] || fail "cc-run: bad timeout"
[[ $model =~ ^(haiku|sonnet|opus)$ ]] || fail "cc-run: bad model"
[[ $budget =~ ^[0-9]{1,3}(\.[0-9]{1,2})?$ ]] || fail "cc-run: bad budget"
[[ -z $resume || $resume =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,63}$ ]] || fail "cc-run: bad session id"
[[ $mode =~ ^(auto|default|acceptEdits|plan|dontAsk)$ ]] || fail "cc-run: bad permission mode"
keyf=$HOME/.config/anthropic-key
[ -s "$keyf" ] || fail "No API key in the box yet (~/.config/anthropic-key)."

dir=$HOME/work/claude; $P/mkdir -p "$dir"
task="$dir/$id.task"; events="$dir/$id.jsonl"
$P/cat > "$task"; : > "$events"

# watching only: the window shows the events as they arrive; the job does not run in it
fmt='if .type=="assistant" then (.message.content[]? | if .type=="text" then "» "+.text elif .type=="tool_use" then "⚙ "+.name+" "+((.input|tostring)[0:160]) else empty end) elif .type=="result" then "── done ("+(.num_turns|tostring)+" turns, $"+(.total_cost_usd|tostring)+")" else empty end'
printf -v watch '%q ' $P/timeout $((secs + 600)) $P/tail -n +1 -F "$events"
printf -v show '%q ' $P/jq -r --unbuffered "$fmt"
$P/tmux kill-window -t "clara:cc-$id" 2>/dev/null
$P/tmux new-window -d -t clara -n "cc-$id" "$watch | $show" 2>/dev/null
{ printf "\n\033[1;36m── %s  claude code task %s (%s, window cc-%s)\033[0m\n" "$($P/date +%T)" "$id" "$model" "$id"
  $P/awk 'NR<=10 {print "  " $0}' "$task"; } >> "$HOME/work/.activity.log"

cd "$HOME/work" || fail "cc-run: no ~/work"
# the result is read from the pipe, not from the events file, which clara's space can edit
r=$(ANTHROPIC_API_KEY=$(< "$keyf") $P/timeout -k 10 "$secs" \
      $P/setpriv --no-new-privs \
      $P/env PATH="$HOME/venv/bin:/usr/local/bin:/usr/bin:/bin" DISABLE_AUTOUPDATER=1 \
        CLAUDE_CODE_PROMPT_CACHE_TTL="${CC_CACHE_TTL:-1h}" \
      /usr/local/bin/claude -p "$($P/cat "$task")" --bare --setting-sources "" \
        --append-system-prompt-file /etc/clara-box/CLAUDE.md \
        --model "$model" --max-budget-usd "$budget" --permission-mode "$mode" \
        --output-format stream-json --verbose ${resume:+--resume "$resume"} < /dev/null 2>/dev/null \
    | $P/tee -a "$events" | $P/grep --line-buffered '"type":"result"' | $P/tail -n 1)
if [ -n "$r" ]; then echo "$r"; else fail "Claude Code gave no result (timed out after ${secs}s or failed); see tmux window cc-$id."; fi
