#!/bin/bash
# What Clara's Claude Code jobs have cost (ledger kept on this machine, outside her box).
#   clara-box-costs          this month and today
#   clara-box-costs 7        also each job of the last 7 days
cd "${CLARA_CODE_DIR:-$HOME/Projects/clara-code}" || exit 1
py=.venv/bin/python; [ -x "$py" ] || py=python3
exec "$py" tools/claude_box_relay.py --costs "$@"
