#cloud-config
disable_root: true
ssh_pwauth: false
users:
  - name: admin
    gecos: Box admin (owner only)
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys: ["@ADMIN_KEY@"]
  - name: clara
    gecos: Clara
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys: ["restrict,pty @AGENT_KEY@"]
package_update: true
packages: [tmux, nftables, python3, python3-venv, python3-pip, git, curl, ca-certificates, jq, less, file, unzip]
write_files:
  - path: /etc/nftables.conf
    permissions: "0644"
    content: |
      #!/usr/sbin/nft -f
      flush ruleset
      table inet clara {
        set private4 { type ipv4_addr; flags interval; elements = {
          0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
          172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 } }
        chain input {
          type filter hook input priority 0; policy drop;
          iif lo accept
          ct state established,related accept
          tcp dport 22 accept
          tcp dport 8100-8119 accept
          icmp type echo-request accept
        }
        chain output {
          type filter hook output priority 0; policy accept;
          oif lo accept
          ct state established,related accept
          ip daddr @private4 reject
          meta nfproto ipv6 reject
        }
      }
  - path: /etc/sysctl.d/90-clara.conf
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      kernel.dmesg_restrict = 1
  - path: /etc/systemd/resolved.conf.d/90-public-dns.conf
    content: |
      [Resolve]
      DNS=1.1.1.1 9.9.9.9
      Domains=~.
  - path: /etc/ssh/sshd_config.d/90-clara.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AllowTcpForwarding no
      AllowStreamLocalForwarding no
      X11Forwarding no
      AllowAgentForwarding no
      PermitTunnel no
runcmd:
  - [chmod, "700", /home/clara, /home/admin]
  - [systemctl, enable, --now, nftables]
  - [sysctl, --system]
  - [systemctl, restart, ssh]
  - [passwd, -l, root]
# After first boot (see docs/CLARA_BOX.md): disable cloud-init networking and pin public DNS
# (the DHCP DNS is the router, which the firewall blocks), then install the tools.
